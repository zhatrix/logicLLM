# 推理后端：mlx（微调后模型，scripts/serve_mlx.sh）或 ollama（快速回退）
LLM_BACKEND=mlx
# LLM_BASE_URL=http://127.0.0.1:8080/v1
# LLM_MODEL=default_model   # mlx_lm.server 用此名指代命令行加载的模型+LoRA
BASE_MODEL=mlx-community/Qwen3-14B-4bit
EMBED_MODEL=BAAI/bge-m3
RAG_TOP_K=4

# 工具后端：mock（内置演示库）| tms（对接本地零担通 TMS）
# TOOLS_BACKEND=tms
# TMS_BASE_URL=http://127.0.0.1:8000/api/v1
# TMS_PHONE=13800000001          # 开发种子账号（seed_dev.py），生产请改专用只读账号
# TMS_PASSWORD=Dev@12345
# TMS_TENANT=Dev Tenant
